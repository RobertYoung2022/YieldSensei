# OpenAI API Key for YieldSensei's AI capabilities
OPENAI_API_KEY=

# DeFi Protocol APIs
DEFILLAMA_API_KEY=
ETHERSCAN_API_KEY=

# RPC Endpoints
NEXT_PUBLIC_MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/your-api-key
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Feature Flags
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Optional: Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_ID=

# Instructions:
# 1. Copy this file to .env
# 2. Replace empty values with your actual API keys and endpoints
# 3. Never commit the actual .env file to version control